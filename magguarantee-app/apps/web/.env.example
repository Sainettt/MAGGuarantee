# Browser-side base URL for the API. Used by client components / fetch calls
# that run in the user's browser.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-side base URL for the API. Used by Server Components, Route Handlers
# and middleware running inside the Next.js Node process. In dev these point
# at the same host, but in containerised prod the server-side URL may use the
# internal docker network hostname while the public one stays external.
API_URL=http://localhost:3001
