# Environment for the shared Caddy stack — copy to /opt/caddy/.env.
#
#   cp /opt/caddy/.env.example /opt/caddy/.env
#
# Compose auto-loads it (it sits next to docker-compose.yml). After editing,
# recreate the container — `caddy reload` does NOT see new env values:
#
#   cd /opt/caddy && docker compose up -d

# ── PROD only (Caddyfile.prod) ───────────────────────────────────────────────
# LAN address(es) the corporate nginx connects FROM, as CIDRs separated by
# spaces, e.g. `10.20.30.40/32` or `10.20.30.40/32 10.20.30.41/32`.
#
# Caddy trusts X-Forwarded-For only from these peers. Until it is set, the api
# records nginx's address as the client IP for every request and all users
# share one login rate-limit bucket.
#
# NEVER 0.0.0.0/0, a whole /8, or `private_ranges`: any host that can reach :80
# could then forge its own client IP. Exact /32 addresses only.
#
# Find it: sudo tcpdump -n -i any 'tcp port 80 and tcp[tcpflags] & tcp-syn != 0'
# then open https://mymag.magtrans.eu once — the SYN's source IP is the value.
#
# Verify after `docker compose up -d`: log in, then the newest audit_log rows
# (and `client_ip` in `docker compose logs caddy`) must show YOUR address, not
# nginx's.
#
# Staging (Caddyfile) ignores this variable — leave it empty there.
UPSTREAM_PROXY_CIDRS=
