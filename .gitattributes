# Default: treat all files as text and enforce LF in the repo.
# Working-tree checkout will also use LF — overrides core.autocrlf for this repo.
* text=auto eol=lf

# ─── Source ────────────────────────────────────────────────
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.cjs       text eol=lf
*.mjs       text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.md        text eol=lf
*.mdx       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf

# ─── Prisma / SQL ──────────────────────────────────────────
*.prisma    text eol=lf
*.sql       text eol=lf

# ─── Shell / config ────────────────────────────────────────
*.sh        text eol=lf
*.bash      text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf
.editorconfig text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf
.npmrc       text eol=lf
.nvmrc       text eol=lf
.env*        text eol=lf

# ─── Windows-specific scripts must keep CRLF ───────────────
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# ─── Legacy Google Apps Script files ───────────────────────
*.gs        text eol=lf

# ─── Binary files (never normalize) ────────────────────────
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.svg       text eol=lf
*.pdf       binary
*.zip       binary
*.gz        binary
*.tgz       binary
*.tar       binary
*.7z        binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary
*.mp4       binary
*.webm      binary
*.mp3       binary
*.wav       binary

# ─── Linguist hints (cleaner GitHub language stats / diffs) ─
package-lock.json    linguist-generated=true
*.snap               linguist-generated=true
docs/screenshots/**  linguist-vendored=true
Code.gs              linguist-vendored=true
index.html           linguist-vendored=true
