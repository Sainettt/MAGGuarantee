# Browser-side base URL for the API. Used by client components / fetch calls
# that run in the user's browser.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-side base URL for the API. Used by Server Components, Route Handlers
# and middleware running inside the Next.js Node process. In dev these point
# at the same host, but in containerised prod the server-side URL may use the
# internal docker network hostname while the public one stays external.
API_URL=http://localhost:3001

# Testing-only: set true to allow registering backdated (past) wyjazdy in the
# UI (disables the `min` hint + pre-submit check). Must match the api
# `ALLOW_PAST_DEPARTURE` for a full bypass. Baked at build time (NEXT_PUBLIC_*).
NEXT_PUBLIC_ALLOW_PAST_DEPARTURE=false

# Google OAuth *Web application* client id, from the company GCP project. This
# is the SAME value the api validates the `aud` claim against — it is a public
# identifier, not a secret, and there is deliberately no client secret here (the
# front-side GIS flow never exchanges an authorization code).
#
# Baked at build time (NEXT_PUBLIC_*). Leave it EMPTY to switch Google sign-in
# off: the button then renders nothing and only the password form is shown,
# which is the right state for a dev machine with no GCP setup.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# BugBot header buttons («Zgłoś problem» for everyone, «Zgłoś pomysł» for
# admins). Baked at build time (NEXT_PUBLIC_*). Only the exact value `true`
# shows them; anything else (incl. empty) hides them. The api must have its
# BUGBOT_* settings too — without them the handoff endpoint answers 404 and the
# buttons would only ever show the inline error.
NEXT_PUBLIC_BUGBOT_ENABLED=
