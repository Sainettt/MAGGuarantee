NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
DATABASE_URL=postgresql://magguarantee:sainet123@localhost:5432/magguarantee?schema=public
REDIS_URL=redis://localhost:6379
WEB_URL=http://localhost:3000

# ── Google Chat wyjazd notification ─────────────────────
# Incoming-webhook URL of the standing "wyjazdy" Google Chat space. When a
# carrier registers a wyjazd (POST /delegations) the API posts a 4-line
# message here via the `chat-notify-wyjazd` BullMQ queue. LEAVE BLANK in dev
# / test — the chat processor no-ops silently when this is unset.
# See docs/16-jobs-and-integrations.md#google-chat-notifications.
GOOGLE_CHAT_WYJAZD_WEBHOOK_URL=

# ── JWT ─────────────────────────────────────────────────
# Two DISTINCT secrets, each >= 32 bytes random.
# Generate: `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-min-32-chars-AAAAAAAAAAAAAAAAAAAAAAAA
JWT_REFRESH_SECRET=change-me-min-32-chars-BBBBBBBBBBBBBBBBBBBBBBBB-DIFFERENT-from-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Password hashing ────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Mail (Phase 1: SMTP / Mailhog. Phase 9: Gmail API.) ─
MAIL_PROVIDER=smtp
# Inside docker-compose: MAIL_SMTP_HOST=mailhog
# From host machine (npm run dev outside docker): MAIL_SMTP_HOST=localhost
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_FROM=no-reply@magtrans.eu
# Deeplink target for transactional emails (e.g. authorization-request email
# to Maksim). Same host as WEB_URL today, kept as a distinct key for future
# divergence (public mirror, custom domain, etc.).
APP_URL=http://localhost:3000

# ── S3 / object storage (MinIO in dev) ──────────────────
# Vehicle umowa / cabotage screenshot uploads + claim auth screenshots.
# Dev defaults point at the docker-compose `minio` service.
# Inside docker-compose: S3_ENDPOINT=http://minio:9000
# From host machine (npm run dev outside docker): S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=magguarantee

# ── GPS tracker (Phase 2 skeleton) ──────────────────────
# Mock returns deterministic positions; vendor is a stub until MAGTRANS
# supplies credentials. See docs/16-jobs-and-integrations.md#gps-tracker.
GPS_PROVIDER=mock
GPS_VENDOR_BASE_URL=
GPS_VENDOR_API_KEY=
GPS_POLL_INTERVAL_SEC=90
GPS_CACHE_TTL_SEC=300
