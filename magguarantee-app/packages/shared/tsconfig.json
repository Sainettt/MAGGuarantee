{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Emit CommonJS so the api (NestJS, CJS) can `require` us at runtime.
    // `module: ESNext` from the base config wouldn't load under plain Node.
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
