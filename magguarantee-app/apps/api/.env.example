NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
DATABASE_URL=postgresql://magguarantee:sainet123@localhost:5432/magguarantee?schema=public
REDIS_URL=redis://localhost:6379
WEB_URL=http://localhost:3000

# Reverse-proxy hops between the browser and this process — decides which
# X-Forwarded-For entry becomes the client IP in the audit log and the
# rate-limit bucket key. 0 locally (no proxy), 1 on staging (Caddy), 2 in prod
# (corporate nginx → Caddy). Leave at the default unless you run behind a proxy.
TRUST_PROXY_HOPS=1

# ── Google Chat wyjazd notification ─────────────────────
# Incoming-webhook URL of the standing "wyjazdy" Google Chat space. When a
# carrier registers a wyjazd (POST /delegations) the API posts a 6-line
# message here via the `chat-notify-wyjazd` BullMQ queue. LEAVE BLANK in dev
# / test — the chat processor no-ops silently when this is unset.
# See docs/16-jobs-and-integrations.md#google-chat-notifications.
GOOGLE_CHAT_WYJAZD_WEBHOOK_URL=

# ── JWT ─────────────────────────────────────────────────
# Two DISTINCT secrets, each >= 32 bytes random.
# Generate: `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-min-32-chars-AAAAAAAAAAAAAAAAAAAAAAAA
JWT_REFRESH_SECRET=change-me-min-32-chars-BBBBBBBBBBBBBBBBBBBBBBBB-DIFFERENT-from-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Password hashing ────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Mail ───────────────────────────────────────────────
# Provider selector: `smtp` (dev/staging → Mailhog) or `gmail` (production →
# Gmail API with RFC threading). Default `smtp`.
MAIL_PROVIDER=smtp
# Inside docker-compose: MAIL_SMTP_HOST=mailhog
# From host machine (npm run dev outside docker): MAIL_SMTP_HOST=localhost
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_FROM=no-reply@magtrans.eu
# Optional hosted logo for the transactional-email header (docs/22-email-design.md).
# LEAVE BLANK in dev/test — the header falls back to a self-contained "MAGTRANS"
# text wordmark (no remote fetch). In production point it at a public PNG, e.g.
# MAIL_LOGO_URL=https://www.magtrans.eu/img/logo.png
MAIL_LOGO_URL=
# Recipient of the Maksim over-threshold confirmation-request email (auto-sent
# at verification when the dopłata crosses the auth threshold). Default (when
# unset) = the production director address; OVERRIDE on dev/staging stands so
# test clicks don't email the real director. See docs/16-jobs-and-integrations.md.
MAKSIM_EMAIL=maksim.siankevich@magtrans.eu

# Gmail API via OAuth 2.0 (REQUIRED only when MAIL_PROVIDER=gmail; blank for
# Mailhog). Authenticates as ONE Workspace mailbox through a long-lived refresh
# token — NOT Domain-Wide Delegation. Get the refresh token once:
#   1) GCP: OAuth consent screen Internal + Publish, scope
#      https://www.googleapis.com/auth/gmail.send; create an OAuth client
#      (Web app) with redirect http://localhost:53682/oauth2callback.
#   2) GMAIL_OAUTH_CLIENT_ID=... GMAIL_OAUTH_CLIENT_SECRET=... npm run gmail:token
#      log in AS the sending mailbox, click Allow, paste the printed token here.
# See docs/16-jobs-and-integrations.md.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# From header recipients see. May be the OAuth mailbox itself, one of its aliases,
# or — as in production — a no-reply Google Group; anything here must be a valid
# send-as of that mailbox or Gmail silently rewrites From. Prod value:
# no-reply@magtrans.eu (one-way channel, see docs/16 §Односторонний канал).
GMAIL_FROM=
# Deeplink target for transactional emails (e.g. the Maksim over-threshold
# confirmation-request email). Same host as WEB_URL today, kept as a distinct
# key for future divergence (public mirror, custom domain, etc.).
APP_URL=http://localhost:3000

# ── S3 / object storage (MinIO in dev) ──────────────────
# Vehicle umowa / cabotage screenshot uploads + claim auth screenshots.
# Dev defaults point at the docker-compose `minio` service.
# Inside docker-compose: S3_ENDPOINT=http://minio:9000
# From host machine (npm run dev outside docker): S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=magguarantee

# ── GPS tracker (Phase 2 skeleton) ──────────────────────
# Mock returns deterministic positions; vendor is a stub until MAGTRANS
# supplies credentials. See docs/16-jobs-and-integrations.md#gps-tracker.
GPS_PROVIDER=mock
GPS_VENDOR_BASE_URL=
GPS_VENDOR_API_KEY=
GPS_POLL_INTERVAL_SEC=90
GPS_CACHE_TTL_SEC=300

# ── Feature flags / testing ─────────────────────────────
# Testing-only override. When `true`, a carrier may register a wyjazd
# (POST /delegations) with a `departureAt` in the past; default `false`
# ENFORCES the rule (server rejects past departures with 422 DEPARTURE_IN_PAST).
# Only the literal value "true"/"1" enables the bypass; "false"/""/absent = off.
ALLOW_PAST_DEPARTURE=false

# ── Guarantee Watchdog (plan §6) ────────────────────────
# Daily cron (07:10 Europe/Warsaw) that reminds carriers + opiekuni to report a
# wyjazd within N Polish working days of a guaranteed vehicle's last return, and
# records violations. See docs/16-jobs-and-integrations.md.
# GUARANTEE_WATCHDOG_ENABLED — kill-switch on rollout. Default ON; only the
# literal "false"/"0" disables it ("true"/"1"/""/absent = enabled).
GUARANTEE_WATCHDOG_ENABLED=true
# Working days from the anchor to the wyjazd deadline (default 10).
GUARANTEE_DEADLINE_WORKING_DAYS=10
# Reminder offsets in working days before the deadline, CSV (default "3,1" →
# D-3 and D-1). Parsed + de-duplicated + sorted descending by the API.
GUARANTEE_REMINDER_OFFSETS=3,1

# ── Vehicle-removal alert (vehicle-status rework, Step B) ─
# Daily cron (07:20 Europe/Warsaw) that emails ALL active admins the list of
# LIVE vehicles idle ≥29 calendar days (status „do usunięcia”), re-sending every
# N days. The ≥29-day threshold is a shared constant, not env. See
# docs/16-jobs-and-integrations.md#vehicle-removal-alert.
# VEHICLE_REMOVAL_ALERT_ENABLED — kill-switch. Default ON; only "false"/"0"
# disables it ("true"/"1"/""/absent = enabled).
VEHICLE_REMOVAL_ALERT_ENABLED=true
# Calendar days between repeated admin digests for a still-„do usunięcia”
# vehicle (default 3).
VEHICLE_REMOVAL_ALERT_REPEAT_DAYS=3

# ── Token cleanup cron (03:30 Europe/Warsaw) ───────────────
# Hard-deletes refresh tokens expired / revoked more than 30 days ago and prunes
# email_logs rows older than EMAIL_LOG_RETENTION_DAYS. Writes system.* audit rows.
# TOKEN_CLEANUP_ENABLED — kill-switch. Default ON; only "false"/"0" disables it.
TOKEN_CLEANUP_ENABLED=true
# Days an email_logs delivery row is kept (default 180).
EMAIL_LOG_RETENTION_DAYS=180

# ── Ops alerts ──────────────────────────────────────────────
# Google Chat incoming-webhook URL of the OPS space (not the wyjazdy space).
# Receives permanent BullMQ job failures, cron crashes and Redis/queue
# connection errors — max one message per alert kind per 10 minutes.
# LEAVE BLANK in dev/test: alerts are then written to the log only.
# The URL contains the webhook key — treat it as a secret.
OPS_ALERT_WEBHOOK_URL=

# ── Google SSO + MAGSpace employee directory (docs/24) ───
# Employees sign in with Google; MAGSpace answers "is this an active employee
# and on which stanowisko"; a mapping table in this app turns that into a role.
#
# ALL FOUR KEYS ARE OPTIONAL. Leave GOOGLE_OAUTH_CLIENT_ID and
# MAGSPACE_INTERNAL_TOKEN empty on a dev machine: the Google button disappears
# from /login, the reconcile job is not scheduled, and login by password + 2FA
# is completely unaffected. That is the intended state for local work.
#
# GOOGLE_OAUTH_CLIENT_ID — the *Web application* client from the company GCP
# project. Same value as the web bundle's NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID:
# it is what the incoming id_token's `aud` claim must equal. Public, not secret;
# there is no client SECRET here because the browser-side flow never exchanges
# an authorization code.
GOOGLE_OAUTH_CLIENT_ID=
# Workspace domain the `hd` claim must equal. Do not relax this — without it,
# any personal @gmail.com whose address matches an employee's would pass.
SSO_ALLOWED_HD=magtrans.eu

# MAGSpace directory API. In docker this is the container name on the shared
# `magtrans-internal` network; running MAGSpace from source locally, start it
# with API_PORT=3002 — both APIs default to 3001.
MAGSPACE_API_URL=http://magspace-api:3001
# Same token as in MAGSpace's own .env, ≥32 chars. MAGSpace accepts a
# comma-separated list so rotation is add-new → switch here → remove-old.
#   openssl rand -base64 48
MAGSPACE_INTERNAL_TOKEN=

# Reconcile job — pulls the full roster and re-syncs directory-managed users.
# `enforce` applies the changes; `report` only emails the admins what it WOULD
# do. The interval is the worst-case delay between "fired in MAGSpace" and
# "cannot open MAGGuarantee"; the check at sign-in is always live.
DIRECTORY_RECONCILE_MODE=enforce
DIRECTORY_RECONCILE_INTERVAL_MIN=15
# Kill-switch. Default ON; only "false"/"0" disables it.
DIRECTORY_RECONCILE_ENABLED=true
