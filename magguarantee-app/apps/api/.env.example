NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
DATABASE_URL=postgresql://magguarantee:sainet123@localhost:5432/magguarantee?schema=public
REDIS_URL=redis://localhost:6379
WEB_URL=http://localhost:3000

# ── Google Chat wyjazd notification ─────────────────────
# Incoming-webhook URL of the standing "wyjazdy" Google Chat space. When a
# carrier registers a wyjazd (POST /delegations) the API posts a 4-line
# message here via the `chat-notify-wyjazd` BullMQ queue. LEAVE BLANK in dev
# / test — the chat processor no-ops silently when this is unset.
# See docs/16-jobs-and-integrations.md#google-chat-notifications.
GOOGLE_CHAT_WYJAZD_WEBHOOK_URL=

# ── JWT ─────────────────────────────────────────────────
# Two DISTINCT secrets, each >= 32 bytes random.
# Generate: `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-min-32-chars-AAAAAAAAAAAAAAAAAAAAAAAA
JWT_REFRESH_SECRET=change-me-min-32-chars-BBBBBBBBBBBBBBBBBBBBBBBB-DIFFERENT-from-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Password hashing ────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Mail ───────────────────────────────────────────────
# Provider selector: `smtp` (dev/staging → Mailhog) or `gmail` (production →
# Gmail API with RFC threading). Default `smtp`.
MAIL_PROVIDER=smtp
# Inside docker-compose: MAIL_SMTP_HOST=mailhog
# From host machine (npm run dev outside docker): MAIL_SMTP_HOST=localhost
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_FROM=no-reply@magtrans.eu

# Gmail API via OAuth 2.0 (REQUIRED only when MAIL_PROVIDER=gmail; blank for
# Mailhog). Authenticates as ONE Workspace mailbox through a long-lived refresh
# token — NOT Domain-Wide Delegation. Get the refresh token once:
#   1) GCP: OAuth consent screen Internal + Publish, scope
#      https://www.googleapis.com/auth/gmail.send; create an OAuth client
#      (Web app) with redirect http://localhost:53682/oauth2callback.
#   2) GMAIL_OAUTH_CLIENT_ID=... GMAIL_OAUTH_CLIENT_SECRET=... npm run gmail:token
#      log in AS the sending mailbox, click Allow, paste the printed token here.
# See docs/16-jobs-and-integrations.md.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# From header recipients see. May be the OAuth mailbox itself OR one of its
# aliases (must be a valid send-as of that mailbox), e.g. magguarantee@magtrans.eu.
GMAIL_FROM=
# Deeplink target for transactional emails (e.g. authorization-request email
# to Maksim). Same host as WEB_URL today, kept as a distinct key for future
# divergence (public mirror, custom domain, etc.).
APP_URL=http://localhost:3000

# ── S3 / object storage (MinIO in dev) ──────────────────
# Vehicle umowa / cabotage screenshot uploads + claim auth screenshots.
# Dev defaults point at the docker-compose `minio` service.
# Inside docker-compose: S3_ENDPOINT=http://minio:9000
# From host machine (npm run dev outside docker): S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=magguarantee

# ── GPS tracker (Phase 2 skeleton) ──────────────────────
# Mock returns deterministic positions; vendor is a stub until MAGTRANS
# supplies credentials. See docs/16-jobs-and-integrations.md#gps-tracker.
GPS_PROVIDER=mock
GPS_VENDOR_BASE_URL=
GPS_VENDOR_API_KEY=
GPS_POLL_INTERVAL_SEC=90
GPS_CACHE_TTL_SEC=300

# ── Feature flags / testing ─────────────────────────────
# Testing-only override. When `true`, a carrier may register a wyjazd
# (POST /delegations) with a `departureAt` in the past; default `false`
# ENFORCES the rule (server rejects past departures with 422 DEPARTURE_IN_PAST).
# Only the literal value "true"/"1" enables the bypass; "false"/""/absent = off.
ALLOW_PAST_DEPARTURE=false
