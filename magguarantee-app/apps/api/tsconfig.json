{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "outDir": "./dist",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "noEmit": false,
    "sourceMap": true,
    "declaration": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  // Tests + src for type-check & ts-jest. The build pass uses
  // tsconfig.build.json (rootDir narrowed to ./src) so emit lands at
  // dist/main.js and not dist/apps/api/src/main.js.
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["dist", "node_modules"]
}
