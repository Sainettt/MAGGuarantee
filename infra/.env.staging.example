# MAGGuarantee — STAGING .env template.
#
# Copy to `infra/.env` and fill in the blanks. `infra/.env` is gitignored —
# only this template lives in the repo, never a file with real secrets.
#
# Compose auto-loads `infra/.env` (it sits next to docker-compose.staging.yml)
# BOTH for `${...}` interpolation in the compose file AND for the per-service
# `env_file:` directives. No `--env-file` flag, no parent-dir tricks.
#
#   VPS path:  /opt/magguarantee/src/infra/.env   (chmod 0600, owner: deploy)
#   Local:     <repo>/infra/.env
#
# For production use `.env.prod.example` instead — it differs in mail provider,
# data paths, feature flags and public URLs.
#
# ── How the schema treats blanks (apps/api/src/config/env.schema.ts) ─────────
# Secrets below are left EMPTY on purpose: an empty required secret fails LOUDLY
# at api boot with a clear zod message, whereas a fake placeholder would boot the
# app on a secret that is public knowledge. Fill them before first start.
#
# But blank is NOT universally safe — three groups behave differently:
#   • blank == absent (fine):  MAIL_LOGO_URL, GMAIL_OAUTH_*, GMAIL_FROM,
#     ALLOW_PAST_DEPARTURE, GPS_VENDOR_*, GOOGLE_CHAT_WYJAZD_WEBHOOK_URL
#   • blank BREAKS boot (needs a real value or the whole line removed):
#     every numeric key (PORT, *_PORT, BCRYPT_ROUNDS, GPS_*_SEC, …), every enum
#     (NODE_ENV, LOG_LEVEL, MAIL_PROVIDER, GPS_PROVIDER), every URL
#     (DATABASE_URL, REDIS_URL, WEB_URL, APP_URL, S3_ENDPOINT), MAKSIM_EMAIL,
#     and S3_ACCESS_KEY / S3_SECRET_KEY / S3_BUCKET
#   • absent == coded default: see the commented-out cron block at the bottom

# ── Where Postgres / Redis / MinIO data live on the HOST disk ────────────────
# These are compose-level bind-mount paths, NOT app config — they decide where
# the bytes physically land. Relative paths resolve against the directory of
# docker-compose.staging.yml (i.e. `infra/`), not the repo root.
#
# Local:  leave as-is → <repo>/infra/data/{postgres,redis,minio}
# VPS:    switch ALL THREE to absolute /opt/magguarantee/data/* — otherwise the
#         data lands inside the git checkout at /opt/magguarantee/src/infra/data,
#         where the backup job will not find it and `git clean -xfd` destroys it.
#
# NEVER repoint a path on a live stack: the container comes up against an empty
# directory and every uploaded file "disappears". Stop the stack, `mv` the
# directory, then edit the path.
POSTGRES_DATA=./data/postgres
REDIS_DATA=./data/redis
MINIO_DATA=./data/minio

# ── Postgres ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
# Consumed by compose interpolation, which aborts with a clear error if empty.
POSTGRES_PASSWORD=

# ── API runtime ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# Inside the docker network postgres resolves by service name. Paste the same
# value as POSTGRES_PASSWORD over the marker below — compose does NOT expand
# ${...} inside env_file lines.
DATABASE_URL=postgresql://magguarantee:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/magguarantee?schema=public
REDIS_URL=redis://redis:6379

# ── Public URLs ──────────────────────────────────────────────────────────────
# Staging serves web AND api from a SINGLE origin — Caddy path-routes /api/* to
# the api container, everything else to web (the OVH hostname has no subdomains
# we control). So all three URLs below are the same value.
#
# WEB_URL           — CORS origin + cookie scope
# APP_URL           — base for deeplinks in transactional emails
# NEXT_PUBLIC_API_URL — baked into the CLIENT bundle at BUILD time; changing it
#                     requires `docker compose build web`, not just a restart
#
# Local: http://localhost:3000 / http://localhost:3000 / http://localhost:3001
WEB_URL=https://vps-29a0acba.vps.ovh.net
APP_URL=https://vps-29a0acba.vps.ovh.net
NEXT_PUBLIC_API_URL=https://vps-29a0acba.vps.ovh.net

# API_URL is the server-side base used by Next.js Route Handlers / Server
# Components running INSIDE the web container — must resolve on the docker
# network, so it is a container hostname, not a public URL.
API_URL=http://magguarantee-api:3001

# ── JWT — TWO DISTINCT secrets, 32+ chars each ───────────────────────────────
# Generate each separately:  openssl rand -base64 48
# The schema enforces the 32-char minimum but CANNOT tell you they are
# identical — reusing one value for both silently weakens the token split.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

BCRYPT_ROUNDS=12

# ── Mail — Mailhog on staging ────────────────────────────────────────────────
# Login ALWAYS emails a 2FA code, so a broken mail path means nobody can sign
# in at all. On staging that path is Mailhog: everything is captured, nothing
# reaches a real inbox. View it over an SSH tunnel:
#   ssh -L 8025:localhost:8025 deploy@vps  →  http://localhost:8025
#
# Do NOT set MAIL_PROVIDER=gmail here. The schema only checks that the four
# GMAIL_* keys are non-empty, not that they work — bogus values boot fine and
# then fail at the first send, i.e. at the login code.
MAIL_PROVIDER=smtp
MAIL_SMTP_HOST=mailhog
MAIL_SMTP_PORT=1025
MAIL_FROM=no-reply@magtrans.eu

# Hosted logo for the email header (docs/22-email-design.md). Blank on staging →
# templates fall back to a self-contained text wordmark, no remote fetch.
MAIL_LOGO_URL=

# Recipient of the Maksim over-threshold confirmation email, auto-sent at
# verification when the dopłata crosses the authorization threshold. The coded
# DEFAULT is the real director's address, so keep an override here even though
# Mailhog would swallow it — the day someone flips this stack to real SMTP, an
# unset key starts mailing the director.
# NOTE: a blank value fails boot (`.email()`), unlike most optional keys.
MAKSIM_EMAIL=staging@example.com

# ── Google Chat wyjazd notification ──────────────────────────────────────────
# Incoming-webhook URL of the "wyjazdy" Chat space — every carrier zgłoszenie
# posts a 6-line message there (the INTERNAL heads-up; the carrier separately
# gets a confirmation email). Blank on staging: nobody wants UAT traffic in the
# real space, and the processor no-ops silently when unset.
# Point it at a THROWAWAY space if you want to eyeball the format.
GOOGLE_CHAT_WYJAZD_WEBHOOK_URL=

# ── S3 / object storage (MinIO container) ────────────────────────────────────
# Attachment uploads: driver ID scans, porozumienia, authorization screenshots.
# These five keys are APP config — where api sends bytes. MINIO_DATA at the top
# is a different layer: where MinIO keeps them on disk.
#
# S3_ACCESS_KEY / S3_SECRET_KEY double as MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
# and are baked into the data directory on FIRST init. Changing them later
# against an existing directory breaks auth.
# Generate the secret:  openssl rand -hex 24
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=magguarantee
S3_SECRET_KEY=
S3_BUCKET=magguarantee

# ── GPS (mocked until MAGTRANS provides credentials) ────────────────────────
GPS_PROVIDER=mock
GPS_VENDOR_BASE_URL=
GPS_VENDOR_API_KEY=
GPS_POLL_INTERVAL_SEC=90
GPS_CACHE_TTL_SEC=300

# ── Feature flags / UAT ──────────────────────────────────────────────────────
# Lets a carrier register a wyjazd with `departureAt` in the past, so a full
# claim flow can be demoed in one sitting instead of waiting real days.
# Production rule is "forbidden" — both stay `false` in .env.prod.example.
#
# TWO independent flags, both needed for an end-to-end bypass:
#   ALLOW_PAST_DEPARTURE             → api guard (authoritative, 422 backstop)
#   NEXT_PUBLIC_ALLOW_PAST_DEPARTURE → web form; baked in at BUILD time, so
#                                      changing it needs `compose build web`
# Only the literal "true"/"1" enables; anything else means false.
ALLOW_PAST_DEPARTURE=true
NEXT_PUBLIC_ALLOW_PAST_DEPARTURE=true

# ── Cron jobs — omitted on purpose, defaults shown ───────────────────────────
# All five keys have working defaults in the schema, so leaving them out is
# safe. They are listed here because the two *_ENABLED flags are the kill
# switches: if a cron starts spamming carriers at 07:10, you want to uncomment
# one line and restart, not go hunting through the source.
#
# CAREFUL with the booleans — only "true" and "1" enable them. Any other
# non-empty value ("on", "yes", "TRUE ", a typo) evaluates to FALSE and
# silently disables the job. Blank or absent = the default below.
#
# Guarantee watchdog — daily 07:10 Europe/Warsaw, reminds carriers + opiekuni
# to report a wyjazd within N working days of a guaranteed vehicle's return.
# GUARANTEE_WATCHDOG_ENABLED=true
# GUARANTEE_DEADLINE_WORKING_DAYS=10
# GUARANTEE_REMINDER_OFFSETS=3,1
#
# Vehicle-removal alert — daily 07:20 Europe/Warsaw, emails all active admins
# the vehicles idle >=29 days ("do usunięcia"), re-sending every N days. The
# 29-day threshold itself is a shared constant, not env.
# VEHICLE_REMOVAL_ALERT_ENABLED=true
# VEHICLE_REMOVAL_ALERT_REPEAT_DAYS=3
