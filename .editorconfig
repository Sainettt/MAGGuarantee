root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown: trailing whitespace can be a meaningful line break.
[*.md]
trim_trailing_whitespace = false

# Windows-only scripts must keep CRLF or they won't run.
[*.{bat,cmd,ps1}]
end_of_line = crlf

# Makefile requires real tabs.
[Makefile]
indent_style = tab
