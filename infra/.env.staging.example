# MAGGuarantee — staging .env template.
#
# Copy this file alongside `docker-compose.staging.yml` (or wherever
# `--env-file` points) and fill in the real values. NEVER commit a file
# with real secrets — only this template lives in the repo.
#
# On the VPS, the canonical location is `/opt/magguarantee/.env`
# (chmod 0600, owner: deploy). Compose is then run with
# `--env-file ../.env` from `/opt/magguarantee/src/`.

# ── Where Postgres / Redis data live on disk ─────────────────────────────────
# Local development:   leave defaults — data goes to ./data/{postgres,redis}
#                      under the directory of docker-compose.staging.yml.
# VPS:                 set to /opt/magguarantee/data/postgres etc.
POSTGRES_DATA=./data/postgres
REDIS_DATA=./data/redis

# ── Postgres ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# ── API runtime ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# Inside the docker network, postgres resolves by service name.
# Replace ${POSTGRES_PASSWORD} below with the same value as above
# (compose does NOT recursively expand env vars in env_file lines).
DATABASE_URL=postgresql://magguarantee:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/magguarantee?schema=public
REDIS_URL=redis://redis:6379

# Public URL the browser uses to reach the web app — for CORS, cookie
# Domain attribute and email link generation.
# Local:  http://localhost:3000
# VPS:    https://staging.magtrans.eu
WEB_URL=https://staging.magtrans.eu

# ── JWT — TWO DISTINCT secrets, 32+ bytes each ───────────────────────────────
# Generate each with:  openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

BCRYPT_ROUNDS=12

# ── Mail (Mailhog for staging, swap to Gmail API in Phase 9) ─────────────────
MAIL_PROVIDER=smtp
MAIL_SMTP_HOST=mailhog
MAIL_SMTP_PORT=1025
MAIL_FROM=no-reply@magtrans.eu

# ── GPS (mocked until MAGTRANS provides credentials) ─────────────────────────
GPS_PROVIDER=mock
GPS_VENDOR_BASE_URL=
GPS_VENDOR_API_KEY=
GPS_POLL_INTERVAL_SEC=90
GPS_CACHE_TTL_SEC=300

# ── Web ──────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL is baked into the client bundle at BUILD time and used
# by browser JavaScript — must be the public URL.
# Local:  http://localhost:3001
# VPS:    https://staging-api.magtrans.eu
NEXT_PUBLIC_API_URL=https://staging-api.magtrans.eu

# API_URL is the server-side URL used by Next.js Route Handlers / Server
# Components running inside the web container — must resolve inside the
# docker network.
API_URL=http://magguarantee-api:3001
