# MAGGuarantee — PRODUCTION .env template.
#
# Copy to `infra/.env` on the PROD VPS and fill in the blanks:
#
#   cp infra/.env.prod.example infra/.env
#   chmod 0600 infra/.env
#
# Canonical path: /opt/magguarantee/src/infra/.env (owner: deploy). Compose
# auto-loads it — it sits next to the compose file, so no `--env-file` flag.
#
# EVERY secret here is generated FRESH. Nothing is copied from staging: a
# staging leak must not reach production, and the two stacks must never be able
# to accept each other's tokens.
#
# Keep an offline backup of the finished file (1Password / encrypted archive).
# Without POSTGRES_PASSWORD a Postgres dump cannot be restored — losing the
# .env means losing the database even if the backups survive.
#
# Secrets are left EMPTY on purpose: an empty required key fails LOUDLY at api
# boot, whereas a placeholder would boot the app on a public secret. See
# `.env.staging.example` for which keys tolerate a blank value and which do not.

# ── Where Postgres / Redis / MinIO data live on the HOST disk ────────────────
# Compose-level bind-mount paths — they decide where bytes physically land, and
# they are what the backup job walks. ALWAYS absolute in production: a relative
# path resolves against `infra/`, dropping live data inside the git checkout at
# /opt/magguarantee/src/infra/data, invisible to backups and destroyed by
# `git clean -xfd`.
#
# NEVER repoint a path on a live stack — the container comes up against an empty
# directory and every uploaded file "disappears". Stop the stack, `mv` the
# directory, then edit the path.
POSTGRES_DATA=/opt/magguarantee/data/postgres
REDIS_DATA=/opt/magguarantee/data/redis
MINIO_DATA=/opt/magguarantee/data/minio

# ── Postgres ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# ── API runtime ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# Paste the same value as POSTGRES_PASSWORD over the marker — compose does NOT
# expand ${...} inside env_file lines.
DATABASE_URL=postgresql://magguarantee:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/magguarantee?schema=public
REDIS_URL=redis://redis:6379

# ── Public URLs ──────────────────────────────────────────────────────────────
# Single origin, same shape as staging: Caddy path-routes /api/* to the api
# container and everything else to web. This keeps the cookie behaviour
# identical to what has actually been exercised on staging — SameSite=Lax,
# host-only, no CORS in play.
#
# Splitting into app.* + api.* subdomains also works in principle (same
# registrable domain, so still same-site), but that configuration has never
# been tested end to end. If you do split it, verify login AND token refresh by
# hand before letting users in, and set WEB_URL to the web origin so the api
# CORS allowlist matches.
#
# NEXT_PUBLIC_API_URL is baked into the CLIENT bundle at BUILD time — changing
# it requires `docker compose build web`, not a restart.
WEB_URL=https://app.magtrans.eu
APP_URL=https://app.magtrans.eu
NEXT_PUBLIC_API_URL=https://app.magtrans.eu

# Server-side base used by Next.js Route Handlers / Server Components running
# INSIDE the web container — a docker network hostname, not a public URL.
API_URL=http://magguarantee-api:3001

# ── JWT — TWO DISTINCT secrets, 32+ chars each ───────────────────────────────
# Generate each SEPARATELY:  openssl rand -base64 48
# The schema enforces the length minimum but cannot tell you the two values are
# identical. Run the command twice and paste different output into each.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

BCRYPT_ROUNDS=12

# ── Mail — Gmail API (HARD prerequisite, not a follow-up) ────────────────────
# Login ALWAYS emails a 2FA code, so until this works NOBODY can sign in —
# including the seeded admin. Get it working before the first deploy.
#
# The schema only checks that the four GMAIL_* keys are NON-EMPTY, not that they
# are valid: wrong credentials boot the api cleanly and then fail at the first
# send, which is the login code. Verify by actually logging in, not by /health.
#
# Setup (docs/16-jobs-and-integrations.md, docs/18-launch-and-deployment.md):
#   1. Google Cloud project, enable Gmail API.
#   2. OAuth consent screen: User type Internal, scope
#      https://www.googleapis.com/auth/gmail.send, then PUBLISH it — an
#      unpublished app expires the refresh token after 7 days.
#   3. OAuth client ID (Web application), redirect
#      http://localhost:53682/oauth2callback → client id + secret.
#   4. GMAIL_OAUTH_CLIENT_ID=... GMAIL_OAUTH_CLIENT_SECRET=... npm run gmail:token
#      Sign in AS the sending mailbox, allow, paste the printed refresh token.
MAIL_PROVIDER=gmail
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# From header recipients see. The OAuth mailbox itself, or a valid send-as alias
# of it.
GMAIL_FROM=wnioski@magtrans.eu

# Unused when MAIL_PROVIDER=gmail; kept so a temporary fallback to a real SMTP
# relay (Brevo / Resend / SendGrid) is a two-line edit if Google drags on.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_FROM=no-reply@magtrans.eu

# Hosted logo for the email header (docs/22-email-design.md). Must be publicly
# reachable — mail clients fetch it from the recipient's network.
MAIL_LOGO_URL=https://www.magtrans.eu/img/logo.png

# Recipient of the Maksim over-threshold confirmation email, auto-sent at
# verification when the dopłata crosses the authorization threshold. This is
# the one environment where the real director's address is correct — set it
# explicitly rather than relying on the coded default.
MAKSIM_EMAIL=maksim.siankevich@magtrans.eu

# ── Google Chat wyjazd notification ──────────────────────────────────────────
# Incoming-webhook URL of the standing "wyjazdy" Chat space. Every carrier
# zgłoszenie (POST /delegations) posts a 6-line message there — this is the
# INTERNAL heads-up for planista / dyspozytorzy / opiekun (they are not mailed
# on a wyjazd; only the carrier gets a confirmation email).
#
# Get it in the Chat space: Apps & integrations → Webhooks → Add webhooks →
# name it → copy the URL. Requires a Google Workspace account; the URL is a
# bearer secret (anyone holding it can post to the space) — never commit it.
#
# BLANK is safe: the processor completes the job and logs a skip, so nothing
# breaks, but NOBODY internal is notified about new wyjazdy.
GOOGLE_CHAT_WYJAZD_WEBHOOK_URL=

# ── S3 / object storage ──────────────────────────────────────────────────────
# Attachment uploads: driver ID scans, porozumienia, authorization screenshots.
# Legally retained documents — treat this as data that must survive the VPS.
#
# Option A (default, matches the compose stack): self-hosted MinIO container.
# Cheapest to stand up, but the data sits on the single VPS disk, so
# MINIO_DATA must be in the backup job alongside Postgres. The Postgres-only
# dump script from docs/18 does NOT cover it.
#
# S3_ACCESS_KEY / S3_SECRET_KEY double as MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
# and are baked into the data directory on FIRST init — changing them later
# against an existing directory breaks auth.
# Generate the secret:  openssl rand -hex 24
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=magguarantee
S3_SECRET_KEY=
S3_BUCKET=magguarantee

# Option B (recommended once there is real data): external S3 — Cloudflare R2
# or Hetzner Object Storage. Offsite by design, versioning available, and it
# removes MinIO + MINIO_DATA + one backup target from your responsibility.
# Swap the block above for:
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=magguarantee-screenshots-prod
# then drop the `minio` + `minio-init` services from the compose file and
# remove MINIO_DATA above.

# ── GPS (mocked until MAGTRANS provides credentials) ────────────────────────
GPS_PROVIDER=mock
GPS_VENDOR_BASE_URL=
GPS_VENDOR_API_KEY=
GPS_POLL_INTERVAL_SEC=90
GPS_CACHE_TTL_SEC=300

# ── Feature flags ────────────────────────────────────────────────────────────
# Backdated wyjazdy are FORBIDDEN in production. Both flags stay false.
# NEXT_PUBLIC_ALLOW_PAST_DEPARTURE is baked in at build time, so a stale `true`
# survives a restart and only a `docker compose build web` clears it — check
# the built image, not just this file.
ALLOW_PAST_DEPARTURE=false
NEXT_PUBLIC_ALLOW_PAST_DEPARTURE=false

# ── Cron jobs — omitted on purpose, defaults shown ───────────────────────────
# All five have working defaults, so leaving them out is safe and correct. They
# are listed because the two *_ENABLED flags are the kill switches: when a cron
# misfires against real carriers at 07:10, you want to uncomment one line and
# restart rather than ship a code change.
#
# CAREFUL with the booleans — only "true" and "1" enable them. Any other
# non-empty value ("on", "yes", a typo) evaluates to FALSE and silently
# disables the job. Blank or absent = the default below.
#
# Guarantee watchdog — daily 07:10 Europe/Warsaw, reminds carriers + opiekuni to
# report a wyjazd within N working days of a guaranteed vehicle's return.
# GUARANTEE_WATCHDOG_ENABLED=true
# GUARANTEE_DEADLINE_WORKING_DAYS=10
# GUARANTEE_REMINDER_OFFSETS=3,1
#
# Vehicle-removal alert — daily 07:20 Europe/Warsaw, emails all active admins
# the vehicles idle >=29 days ("do usunięcia"), re-sending every N days. The
# 29-day threshold is a shared constant, not env.
# VEHICLE_REMOVAL_ALERT_ENABLED=true
# VEHICLE_REMOVAL_ALERT_REPEAT_DAYS=3
